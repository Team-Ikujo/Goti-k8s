# ============================================================
# Goti DB Seed / Reset 스크립트 환경변수
#
# 사용법:
#   1. 이 파일을 복사: cp seed.env.example seed.env
#   2. 값 채우기
#   3. 스크립트 실행: ./seed-2025/run.sh all
#
# DB 접속 방법 2가지 (택 1):
#   A) DB_HOST/USER/PASS 직접 지정
#   B) AWS_SECRET_NAME 으로 Secrets Manager에서 자동 조회
# ============================================================

# === 방법 A: DB 직접 지정 ===
DB_HOST="jdbc:postgresql://goti-prod-postgres.cjqcoy2ce8go.ap-northeast-2.rds.amazonaws.com:5432/goti"
DB_PORT="5432"
DB_NAME="goti"
DB_USER="goti"
DB_PASS="{8Yjc)kruR}UovK.9.Wt{b{b>IN=OF]a"

# === 방법 B: AWS Secrets Manager (위 DB_* 대신 사용) ===
# AWS_SECRET_NAME=goti/rds/credentials
# AWS_REGION=ap-northeast-2

# === Kubernetes ===
K8S_NAMESPACE="goti"
